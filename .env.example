# Copy to .env.local (never commit real values).
# All keys are optional. NPCs still answer without them.

# LLM providers (first configured wins)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# NPC_MODEL=

# Web search
# SEARCH_PROVIDER=searxng
# SEARXNG_URL=https://your-searxng.example
# SEARCH_LANGUAGE=en
# SEARCH_TIME_RANGE=day
# BRAVE_SEARCH_API_KEY=
# NEWS_API_KEY=
