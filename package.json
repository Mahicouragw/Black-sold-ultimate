{
  "name": "black-sword-ultimate",
  "version": "7.37.0",
  "private": true,
  "description": "Accessible open-world multiplayer fantasy RPG",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "build": "node scripts/build-mobile.mjs",
    "pwa:check": "node scripts/pwa-check.mjs",
    "security": "npm audit 2>&1 || true && node scripts/security-check.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "pretest": "node -e \"try{require('fs').accessSync('node_modules/jsdom')}catch{require('child_process').execSync('npm install --no-audit --no-fund',{stdio:'inherit'})}\"",
    "test": "node --test tests/*.test.mjs",
    "audio:validate": "node scripts/validate-audio.mjs",
    "world:validate": "node scripts/validate-world.mjs",
    "validate": "npm run audio:validate && npm run world:validate",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "deploy:verify": "node scripts/deploy.mjs --verify-only",
    "auth": "node scripts/github-auth.mjs",
    "auth:status": "node scripts/github-auth.mjs --status",
    "auth:logout": "node scripts/github-auth.mjs --logout",
    "release": "node scripts/github-auth.mjs --status >/dev/null 2>&1 || node scripts/github-auth.mjs; node scripts/deploy.mjs",
    "token": "node scripts/token.mjs",
    "token:set": "node scripts/token.mjs set",
    "token:clear": "node scripts/token.mjs clear",
    "neon:schema": "node scripts/build-neon-schema.mjs",
    "neon:vendor": "node scripts/vendor-neon.mjs",
    "neon:verify": "node scripts/verify-neon-backend.mjs",
    "neon:keygen": "node scripts/neon-keygen.mjs",
    "neon:recover": "node scripts/neon-recover-handoff.mjs",
    "neon:apply-config": "node scripts/neon-apply-config.mjs --write",
    "neon:migrate": "node scripts/neon-migrate.mjs",
    "neon:refresh": "node scripts/neon-refresh-schema.mjs"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.8",
    "@capacitor/ios": "7.6.9",
    "@neondatabase/neon-js": "^0.9.0-beta",
    "chess.js": "^1.4.0",
    "ipaddr.js": "^2.5.0",
    "pg": "^8.23.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=20.18.1"
  }
}
