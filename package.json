{
  "name": "black-sword-ultimate",
  "version": "7.23.0",
  "private": true,
  "description": "Accessible open-world multiplayer fantasy RPG",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "build": "node scripts/build-mobile.mjs",
    "pwa:check": "node scripts/pwa-check.mjs",
    "security": "npm audit --audit-level=high && node scripts/security-check.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "cap:android": "npm run cap:sync && npx cap open android",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "test": "node --test tests/*.test.mjs",
    "audio:validate": "node scripts/validate-audio.mjs",
    "world:validate": "node scripts/validate-world.mjs",
    "validate": "npm run audio:validate && npm run world:validate",
    "deploy": "node scripts/deploy.mjs",
    "deploy:dry": "node scripts/deploy.mjs --dry-run",
    "deploy:verify": "node scripts/deploy.mjs --verify-only",
    "auth": "node scripts/github-auth.mjs",
    "auth:status": "node scripts/github-auth.mjs --status",
    "auth:logout": "node scripts/github-auth.mjs --logout",
    "release": "node scripts/github-auth.mjs --status >/dev/null 2>&1 || node scripts/github-auth.mjs; node scripts/deploy.mjs",
    "token": "node scripts/token.mjs",
    "token:set": "node scripts/token.mjs set",
    "token:clear": "node scripts/token.mjs clear"
  },
  "dependencies": {
    "@capacitor/android": "7.6.8",
    "@capacitor/core": "7.6.8",
    "@capacitor/ios": "7.6.8",
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.8",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
