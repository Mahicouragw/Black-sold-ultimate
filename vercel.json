{
  "outputDirectory": "www",
  "rewrites": [
    {
      "source": "/api/translate",
      "destination": "/api/translate.js"
    },
    {
      "source": "/api/npc",
      "destination": "/api/npc.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
