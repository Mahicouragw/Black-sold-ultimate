rules_version = '2';

// Black Sword Ultimate — who may read and write what in Cloud Firestore.
//
// How to install: Firebase console → Firestore Database → Rules → replace the
// whole text with this file → Publish.
//
// Everything not listed here is refused.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    // A player who signed in with Google (not a guest).
    function linked() {
      return signedIn() && (request.auth.token.firebase.sign_in_provider != 'anonymous'
        || 'google.com' in request.auth.token.firebase.identities);
    }
    // The game owner: put your own Google e-mail address between the brackets,
    // for example ['myname@gmail.com'], to read the feedback players send.
    function ownerEmails() { return []; }
    function isModerator() {
      return signedIn() && (
        (request.auth.token.get('email_verified', false) == true && request.auth.token.get('email', '') in ownerEmails())
        || (exists(/databases/$(database)/documents/moderator_roles/$(me()))
            && get(/databases/$(database)/documents/moderator_roles/$(me())).data.active == true));
    }
    // "get" of a document that does not exist yet must be allowed, so the game can check before creating it.
    function mine() { return resource == null || resource.data.sender_id == me() || resource.data.receiver_id == me(); }
    function incoming() { return request.resource.data; }
    function changedOnly(fields) { return incoming().diff(resource.data).affectedKeys().hasOnly(fields); }
    function stampedNow() { return incoming().created_at == request.time; }
    function olderThanMinutes(minutes) { return request.time > resource.data.created_at + duration.value(minutes, 'm'); }
    function validBody() { return incoming().body is string && incoming().body.size() >= 1 && incoming().body.size() <= 300; }
    function answering() { return changedOnly(['status', 'updated_at']) && incoming().status in ['accepted', 'rejected']; }

    // ---- players ----------------------------------------------------------
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && me() == userId
        && incoming().id == userId
        && incoming().display_name is string && incoming().display_name.size() >= 1 && incoming().display_name.size() <= 40
        && incoming().level is int && incoming().level >= 1 && incoming().level <= 999;
      allow delete: if false;
    }

    // The private Player ID of each account (a login secret, never shown to other players).
    match /accounts/{userId} {
      allow read, create, update: if signedIn() && me() == userId;
      allow delete: if false;
    }

    match /hero_names/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && incoming().owner_id == me() && incoming().normalized_name == name
        && name.size() >= 2 && name.size() <= 40;
      allow update: if signedIn() && resource.data.owner_id == me() && incoming().owner_id == me() && incoming().normalized_name == name;
      allow delete: if signedIn() && resource.data.owner_id == me();
    }

    // ---- saves ------------------------------------------------------------
    match /game_saves/{userId} {
      allow read, write: if signedIn() && me() == userId;
      match /parts/{part} { allow read, write: if signedIn() && me() == userId; }
    }

    // Player ID + PIN copy. The document name is derived from the Player ID and
    // the PIN, so it can be fetched only by someone who knows both. It can never be listed.
    match /player_recovery/{key} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && incoming().owner_id == me();
      allow update: if signedIn() && resource.data.owner_id == me() && incoming().owner_id == me();
      allow delete: if signedIn() && resource.data.owner_id == me();
      match /parts/{part} {
        allow get: if signedIn();
        allow list: if false;
        // getAfter: the copy and its parts are written together in one batch.
        allow write: if signedIn() && getAfter(/databases/$(database)/documents/player_recovery/$(key)).data.owner_id == me();
      }
    }

    // ---- friends ----------------------------------------------------------
    match /friend_requests/{id} {
      allow get: if signedIn() && mine();
      allow list: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
      allow create: if linked() && incoming().sender_id == me() && incoming().receiver_id != me()
        && id == me() + '_' + incoming().receiver_id && incoming().status == 'pending' && stampedNow();
      allow update: if signedIn() && (
        (resource.data.receiver_id == me() && answering())
        || (linked() && resource.data.sender_id == me() && resource.data.status != 'pending'
            && incoming().sender_id == me() && incoming().receiver_id == resource.data.receiver_id
            && incoming().status == 'pending' && stampedNow()));
      allow delete: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
    }

    // ---- chat: public line and private inboxes (five-minute messages) --------
    match /public_messages/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && incoming().sender_id == me() && incoming().receiver_id == null && validBody() && stampedNow();
      allow update: if false;
      allow delete: if signedIn() && (resource.data.sender_id == me() || olderThanMinutes(5));
    }
    match /inbox/{owner}/messages/{id} {
      allow read: if signedIn() && me() == owner;
      allow create: if signedIn() && incoming().sender_id == me() && incoming().receiver_id is string
        && (owner == me() || owner == incoming().receiver_id) && validBody() && stampedNow();
      allow update: if false;
      allow delete: if signedIn() && me() == owner;
    }

    // ---- feedback ---------------------------------------------------------
    match /game_feedback/{id} {
      allow create: if signedIn() && incoming().user_id == me() && incoming().status == 'new'
        && incoming().message is string && incoming().message.size() >= 3 && incoming().message.size() <= 2000 && stampedNow();
      allow get: if signedIn() && (resource == null || resource.data.user_id == me() || isModerator());
      allow list: if signedIn() && (resource.data.user_id == me() || isModerator());
      allow update, delete: if isModerator();
    }
    // Add a document here by hand (document name = the moderator's user id,
    // field active = true) to let that player read and answer feedback.
    match /moderator_roles/{userId} {
      allow read: if signedIn() && me() == userId;
      allow write: if false;
    }

    // ---- guilds -----------------------------------------------------------
    match /guilds/{guild} {
      allow read: if signedIn();
      allow create: if linked() && incoming().owner_id == me() && incoming().rupees == 0
        && incoming().name is string && incoming().name.size() >= 3 && incoming().name.size() <= 32;
      allow update: if signedIn() && resource.data.owner_id == me() && incoming().owner_id == me();
      allow delete: if signedIn() && resource.data.owner_id == me();
    }
    match /guild_members/{id} {
      allow read: if signedIn();
      allow create: if linked() && incoming().user_id == me() && id == incoming().guild_id + '_' + me() && (
        (incoming().role == 'owner' && get(/databases/$(database)/documents/guilds/$(incoming().guild_id)).data.owner_id == me())
        || (incoming().role == 'member' && get(/databases/$(database)/documents/guild_invites/$(incoming().guild_id + '_' + me())).data.status == 'accepted'));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.user_id == me()
        || get(/databases/$(database)/documents/guilds/$(resource.data.guild_id)).data.owner_id == me());
    }
    match /guild_invites/{id} {
      allow get: if signedIn() && mine();
      allow list: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
      allow create: if linked() && incoming().sender_id == me() && incoming().receiver_id != me()
        && id == incoming().guild_id + '_' + incoming().receiver_id && incoming().status == 'pending'
        && exists(/databases/$(database)/documents/guild_members/$(incoming().guild_id + '_' + me()));
      allow update: if signedIn() && (
        (resource.data.receiver_id == me() && answering())
        || (linked() && resource.data.status != 'pending' && incoming().sender_id == me() && incoming().status == 'pending'
            && incoming().guild_id == resource.data.guild_id && incoming().receiver_id == resource.data.receiver_id
            && exists(/databases/$(database)/documents/guild_members/$(resource.data.guild_id + '_' + me()))));
      allow delete: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
    }

    // ---- combat groups ------------------------------------------------------
    match /combat_groups/{group} {
      allow read: if signedIn();
      allow create: if linked() && incoming().owner_id == me()
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 40;
      allow update: if signedIn() && resource.data.owner_id == me() && incoming().owner_id == me();
      allow delete: if signedIn() && resource.data.owner_id == me();

      // What each member did to the monster; read live by the other members.
      match /actions/{action} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/combat_group_members/$(group + '_' + me()));
        allow create: if signedIn() && incoming().user_id == me() && incoming().group_id == group
          && exists(/databases/$(database)/documents/combat_group_members/$(group + '_' + me()))
          && incoming().damage is number && incoming().damage >= 0 && incoming().damage <= 10000
          && incoming().monster_name is string && incoming().monster_name.size() <= 80 && stampedNow();
        allow update: if false;
        allow delete: if signedIn() && olderThanMinutes(2);
      }
    }
    match /combat_group_members/{id} {
      allow read: if signedIn();
      allow create: if linked() && incoming().user_id == me() && id == incoming().group_id + '_' + me() && (
        (incoming().role == 'leader' && get(/databases/$(database)/documents/combat_groups/$(incoming().group_id)).data.owner_id == me())
        || (incoming().role == 'member' && get(/databases/$(database)/documents/combat_group_invites/$(incoming().group_id + '_' + me())).data.status == 'accepted'));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.user_id == me()
        || get(/databases/$(database)/documents/combat_groups/$(resource.data.group_id)).data.owner_id == me());
    }
    match /combat_group_invites/{id} {
      allow get: if signedIn() && mine();
      allow list: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
      allow create: if linked() && incoming().sender_id == me() && incoming().receiver_id != me()
        && id == incoming().group_id + '_' + incoming().receiver_id && incoming().status == 'pending'
        && exists(/databases/$(database)/documents/combat_group_members/$(incoming().group_id + '_' + me()));
      allow update: if signedIn() && (
        (resource.data.receiver_id == me() && answering())
        || (linked() && resource.data.status != 'pending' && incoming().sender_id == me() && incoming().status == 'pending'
            && incoming().group_id == resource.data.group_id && incoming().receiver_id == resource.data.receiver_id
            && exists(/databases/$(database)/documents/combat_group_members/$(resource.data.group_id + '_' + me()))));
      allow delete: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
    }

    // ---- loot left on the ground for one hour --------------------------------
    match /world_drops/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && incoming().dropped_by == me() && incoming().location_id is string
        && incoming().item_id is string && incoming().quantity is int && incoming().quantity >= 1 && incoming().quantity <= 999
        && incoming().item_snapshot is string && incoming().item_snapshot.size() <= 8000 && stampedNow();
      allow update: if false;
      allow delete: if signedIn();
    }

    // ---- community map notes ---------------------------------------------------
    match /community_map_markers/{id} {
      allow read: if signedIn();
      allow create: if linked() && incoming().creator_id == me()
        && incoming().title is string && incoming().title.size() >= 2 && incoming().title.size() <= 60
        && incoming().note is string && incoming().note.size() >= 2 && incoming().note.size() <= 500;
      allow update: if signedIn() && resource.data.creator_id == me() && incoming().creator_id == me();
      allow delete: if signedIn() && resource.data.creator_id == me();
    }

    // ---- chat rooms -------------------------------------------------------------
    match /chat_rooms/{room} {
      function roomData() { return get(/databases/$(database)/documents/chat_rooms/$(room)).data; }
      function isMember() { return exists(/databases/$(database)/documents/chat_rooms/$(room)/members/$(me())); }
      function isBlocked() { return exists(/databases/$(database)/documents/chat_rooms/$(room)/blacklist/$(me())); }
      function isInvited() { return exists(/databases/$(database)/documents/chat_room_invites/$(room + '_' + me())); }

      allow get: if signedIn() && (resource == null || resource.data.visibility == 'public' || resource.data.owner_id == me() || isMember() || isInvited());
      allow list: if signedIn() && (resource.data.visibility == 'public' || resource.data.owner_id == me());
      allow create: if signedIn() && (
        (room in ['world', 'trade', 'help', 'french'] && incoming().visibility == 'public' && incoming().owner_id == null
          && incoming().activation_minutes == 0 && incoming().member_limit is int && incoming().member_limit <= 200)
        || (room == 'personal_' + me() && incoming().visibility == 'personal' && incoming().owner_id == me())
        || (linked() && incoming().owner_id == me() && incoming().visibility in ['public', 'private']
          && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 40
          && incoming().member_limit is int && incoming().member_limit >= 2 && incoming().member_limit <= 200));
      allow update: if signedIn() && resource.data.owner_id == me() && incoming().owner_id == me()
        && incoming().visibility == resource.data.visibility;
      allow delete: if signedIn() && resource.data.owner_id == me() && resource.data.visibility != 'personal';

      match /members/{member} {
        allow read: if signedIn();
        allow create, update: if signedIn() && me() == member && incoming().user_id == me() && !isBlocked()
          && (roomData().visibility == 'public' || roomData().owner_id == me() || isInvited());
        allow delete: if signedIn() && (me() == member || roomData().owner_id == me());
      }
      match /blacklist/{member} {
        allow read: if signedIn() && (me() == member || roomData().owner_id == me());
        allow write: if signedIn() && roomData().owner_id == me();
      }
      match /messages/{id} {
        allow read: if signedIn() && (roomData().visibility == 'public' || isMember());
        allow create: if signedIn() && incoming().sender_id == me() && incoming().room_id == room
          && isMember() && !isBlocked() && validBody() && stampedNow();
        allow update: if false;
        allow delete: if signedIn() && (resource.data.sender_id == me() || roomData().owner_id == me() || olderThanMinutes(5));
      }
    }
    match /chat_room_invites/{id} {
      allow get: if signedIn() && mine();
      allow list: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
      allow create: if linked() && incoming().sender_id == me() && incoming().receiver_id != me()
        && id == incoming().room_id + '_' + incoming().receiver_id && incoming().status == 'pending'
        && get(/databases/$(database)/documents/chat_rooms/$(incoming().room_id)).data.owner_id == me();
      allow update: if signedIn() && (
        (resource.data.receiver_id == me() && answering())
        || (linked() && resource.data.status != 'pending' && incoming().sender_id == me() && incoming().status == 'pending'
            && incoming().room_id == resource.data.room_id && incoming().receiver_id == resource.data.receiver_id
            && get(/databases/$(database)/documents/chat_rooms/$(resource.data.room_id)).data.owner_id == me()));
      allow delete: if signedIn() && (resource.data.sender_id == me() || resource.data.receiver_id == me());
    }
  }
}
